@@ -281,6 +286,21 @@ CInputCapturePortal::SSession::SSession(sdbus::ObjectPath requestHandle_, sdbus:
         Debug::log(LOG, "[input-capture] Session {} destroyed", sessionHandle.c_str());
         session.release();
         whandle.reset();
+        // The EIS fd arrived over hyprland-input-capture-v1, and a wayland fd
+        // event transfers ownership to the receiver -- so it is ours to close.
+        // Without this, a client that goes away (crash or plain exit) leaves the
+        // socket open for the lifetime of the portal. Every message the EIS
+        // server already wrote into it, including the per-device keymap fds,
+        // stays queued and those fds stay counted as in-flight against the
+        // per-UID AF_UNIX limit. A crash-looping client therefore strands a
+        // batch of fds per restart, until nothing on the default soft
+        // RLIMIT_NOFILE can pass an fd at all (ETOOMANYREFS) -- and the kernel
+        // only garbage-collects such reference cycles above
+        // UNIX_INFLIGHT_TRIGGER_GC, so a few thousand are pinned until reboot.
+        if (eisFD >= 0) {
+            close(eisFD);
+            eisFD = -1;
+        }
         dead = true;
     };
 
@@ -292,7 +312,24 @@ CInputCapturePortal::SSession::SSession(sdbus::ObjectPath requestHandle_, sdbus:
     });
     whandle->setDeactivated([this](CCHyprlandInputCaptureV1*, uint32_t activationId) { g_pPortalManager->m_sPortals.inputCapture->deactivate(sessionHandle, activationId); });
     whandle->setDisabled([this](CCHyprlandInputCaptureV1*) { g_pPortalManager->m_sPortals.inputCapture->disable(sessionHandle); });
-    whandle->setEisFd([this](CCHyprlandInputCaptureV1*, int32_t fd) { eisFD = fd; });
+    whandle->setEisFd([this](CCHyprlandInputCaptureV1*, int32_t fd) {
+        // Defensive: the compositor is not expected to hand us a second fd for
+        // one session, but if it ever does, silently overwriting the member
+        // would leak the previous one exactly like the missing teardown did.
+        if (eisFD >= 0 && eisFD != fd)
+            close(eisFD);
+        eisFD = fd;
+    });
+}
+
+// Backstop for any path that drops an SSession without onDestroy having fired
+// (e.g. the portal shutting down while sessions are still live). onDestroy sets
+// eisFD to -1 after closing, so this cannot double-close.
+CInputCapturePortal::SSession::~SSession() {
+    if (eisFD >= 0) {
+        close(eisFD);
+        eisFD = -1;
+    }
 }
 
 dbUasv CInputCapturePortal::onGetZones(sdbus::ObjectPath requestHandle, sdbus::ObjectPath sessionHandle, std::string appID, std::unordered_map<std::string, sdbus::Variant> opts) {
@@ -509,7 +546,21 @@ void CInputCapturePortal::removeSession(sdbus::ObjectPath sessionHandle) {
     m_sessions.erase(sessionHandle);
 }
 
+// Dead sessions were previously never removed: onDestroy only flagged them, and
+// removeSession() had no callers at all, so m_sessions grew without bound for the
+// lifetime of the portal. A client that crash-loops (each restart creating a
+// fresh session) therefore accumulated one dead entry per restart. Pruning here
+// is safe because a dead session has already released its D-Bus session and
+// wayland handle in onDestroy; this just drops the last reference.
+void CInputCapturePortal::pruneDeadSessions() {
+    const auto REMOVED = std::erase_if(m_sessions, [](const auto& entry) { return entry.second->dead; });
+    if (REMOVED > 0)
+        Debug::log(LOG, "[input-capture] pruned {} dead session(s), {} remaining", REMOVED, m_sessions.size());
+}
+
 void CInputCapturePortal::zonesChanged() {
+    pruneDeadSessions();
+
     if (m_sessions.empty())
         return;
 

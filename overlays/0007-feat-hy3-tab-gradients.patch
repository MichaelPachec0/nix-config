+void Hy3TabBar::onGradientAngleEnd() {
+	// Re-arm to loop, but only while a multi-stop gradient still wants the spin
+	// and the borderangle animation is a looping style. Otherwise let it stop, so
+	// solid-color tabs (or a non-loop style) cause no idle redraws. Clearing the
+	// callback before setValueAndWarp avoids recursing through this handler.
+	if (!this->gradient_angle_wanted) return;
+	if (!this->gradient_angle->enabled() || this->gradient_angle->getStyle() != "loop") return;
+	this->gradient_angle->setCallbackOnEnd(nullptr);
+	this->gradient_angle->setValueAndWarp(0.0f);
+	*this->gradient_angle = 1.0f;
+	this->gradient_angle->setCallbackOnEnd([this](auto) { this->onGradientAngleEnd(); }, false);
 }
 

+#pragma once
+
+#include <hyprland/src/desktop/view/Window.hpp>
+#include <hyprland/src/helpers/AnimatedVariable.hpp>
+#include <hyprland/src/render/decorations/IHyprWindowDecoration.hpp>
+#include <hyprutils/math/Box.hpp>
+
+#include <string>
+#include <vector>
+
+// Rect-scoped video handling. A window carrying one or more
+// `hyprglass_rect:x,y,w,h` tags (window-logical px, set by the playback
+// bridge together with no_dim) gets, from this OVER-layer decoration:
+//
+// 1. rect_redraw: the window's own surface texture redrawn inside each rect
+//    at rect_redraw_alpha (default 1.0). Hyprland drew the window at its rule
+//    opacity over the glass; the redraw puts the source pixels back on top,
+//    so a compositor-translucent window shows its video pixel-exact while
+//    the page around it keeps the glass.
+// 2. rect_dim: the inactive dim, drawn by us with holes at the rects.
+//    Hyprland's dim_inactive is a multiplicative tint uniform in the window
+//    texture shader, whole surface, no region support, hence no_dim on the
+//    window and black-over at the dim strength through Hyprland's own
+//    CRectPassElement with clipBox per remaining piece. Black-over at alpha
+//    d reproduces the `in*(1-d)` tint exactly, so the result is lossless.
+//
+// Fade handover for the dim: Hyprland's own dim keeps animating
+// (m_dimPercent, residual a) after the no_dim flip while this overlay's
+// target D fades in on the same fadeDim curve. Drawing b = 1 - (1-D)/(1-a)
+// keeps the product (1-a)(1-b) equal to (1-D) at every frame, so the
+// crossfade never pops in either direction.
+//
+// rect_padding grows every rect (logical px) before both steps; the
+// `hyprglass_rect_off` tag disables both on one window.
+class CGlassRectDecoration : public IHyprWindowDecoration {
+  public:
+    explicit CGlassRectDecoration(PHLWINDOW window);
+    ~CGlassRectDecoration() override = default;
+
+    [[nodiscard]] SDecorationPositioningInfo getPositioningInfo() override;
+    void                                     onPositioningReply(const SDecorationPositioningReply& reply) override;
+    void                                     draw(PHLMONITOR monitor, float const& alpha) override;
+    [[nodiscard]] eDecorationType            getDecorationType() override;
+    void                                     updateWindow(PHLWINDOW window) override;
+    void                                     damageEntire() override;
+    [[nodiscard]] eDecorationLayer           getDecorationLayer() override;
+    [[nodiscard]] uint64_t                   getDecorationFlags() override;
+    [[nodiscard]] std::string                getDisplayName() override;
+
+    [[nodiscard]] PHLWINDOW getOwner();
+
+  private:
+    PHLWINDOWREF      m_window;
+    PHLANIMVAR<float> m_dim; // D: the dim this overlay wants, focus-driven
+
+    // Rect tags parsed once per tag-set change; m_tagSig is the concatenation
+    // of the rect tags seen last, so an unchanged set costs one string build.
+    std::vector<CBox> m_rects;
+    std::string       m_tagSig;
+    bool              m_off = false; // hyprglass_rect_off seen in the last tag set
+
+    // Returns true when the window carries at least one rect tag and is not
+    // switched off. Refreshes m_rects only when the set changed.
+    bool refreshRects(const PHLWINDOW& window);
+};

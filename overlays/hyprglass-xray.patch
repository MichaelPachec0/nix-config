@@ -2,7 +2,10 @@
 
 CXX ?= g++
 CXXFLAGS = -fPIC -g -O2 -std=c++23
-LDFLAGS = -shared
+# --build-id: without it, crash reporters and coredumpctl cannot match the
+# plugin's frames to symbols and fall back to raw stack scans that misattribute
+# faults to whatever bytes happen to look like return addresses.
+LDFLAGS = -shared -Wl,--build-id=sha1
 INCLUDES = $(shell pkg-config --cflags hyprland pixman-1 libdrm)
 LIBS = $(shell pkg-config --libs hyprland)
 
@@ -11,14 +14,21 @@ ifeq ($(basename $(CXX)),g++)
 endif
 
 TARGET = hyprglass.so
-SOURCES = src/main.cpp src/GlassDecoration.cpp src/GlassPassElement.cpp src/GlassRenderer.cpp src/GlassLayerSurface.cpp src/GlassLayerPassElement.cpp src/GlassLayerCompositeElement.cpp src/PluginConfig.cpp src/ShaderManager.cpp
+SOURCES = src/main.cpp src/GlassDecoration.cpp src/GlassRectDecoration.cpp src/GlassPassElement.cpp src/GlassBackgroundElement.cpp src/GlassRenderer.cpp src/GlassLayerSurface.cpp src/GlassLayerPassElement.cpp src/GlassLayerCompositeElement.cpp src/PluginConfig.cpp src/ShaderManager.cpp
 OBJ = $(SOURCES:.cpp=.o)
+# -MMD -MP (added to the compile rule) emits a .d per object listing the
+# headers it pulled in; -include feeds those back so editing a .hpp rebuilds
+# every object that includes it. Without this, a struct-layout change in a

diff --git a/src/GlassBackgroundElement.cpp b/src/GlassBackgroundElement.cpp
new file mode 100644
index 0000000..f527763
--- /dev/null
+++ b/src/GlassBackgroundElement.cpp
@@ -0,0 +1,55 @@
+#include "GlassBackgroundElement.hpp"
+#include "Globals.hpp"
+
+#include <GLES3/gl32.h>
+#include <hyprland/src/render/OpenGL.hpp>
+#include <hyprland/src/render/Renderer.hpp>
+
+// Same helper GlassRenderer.cpp keeps file-local; duplicated rather than
+// exported to keep the upstream diff surface minimal.
+static GLuint fbId(const SP<Render::IFramebuffer>& framebuffer) {
+    return dynamic_cast<Render::GL::CGLFramebuffer*>(framebuffer.get())->getFBID();
+}
+
+std::vector<UP<IPassElement>> CGlassBackgroundElement::draw() {
+    if (!g_pGlobalState)
+        return {};
+
+    const auto monitor = g_pHyprRenderer->m_renderData.pMonitor.lock();
+    if (!monitor)
+        return {};
+
+    const auto source = g_pHyprRenderer->m_renderData.currentFB;
+    if (!source)
+        return {};
+
+    const int width  = static_cast<int>(source->m_size.x);
+    const int height = static_cast<int>(source->m_size.y);
+    if (width <= 0 || height <= 0)
+        return {};
+
+    auto& backgroundFB = g_pGlobalState->backgroundFB[monitor->m_id];
+    if (!backgroundFB)
+        backgroundFB = g_pHyprRenderer->createFB("hyprglass-background");
+
+    if (backgroundFB->m_size.x != width || backgroundFB->m_size.y != height)
+        backgroundFB->alloc(width, height, source->m_drmFormat);
+
+    // The render pass scissors each element to its damage region and that
+    // state leaks into element draws (see sampleBackground, which has the
+    // same defence). A leaked scissor would silently truncate this
+    // full-screen blit to the damage box.
+    g_pHyprOpenGL->setCapStatus(GL_SCISSOR_TEST, false);
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, fbId(source));
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbId(backgroundFB));
+    glBlitFramebuffer(0, 0, width, height, 0, 0, width, height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+
+    // Re-bind the live framebuffer for whatever element draws next; the blit
+    // above left the draw binding pointed at the capture.
+    glBindFramebuffer(GL_FRAMEBUFFER, fbId(source));
+
+    g_pGlobalState->backgroundFBDirty[monitor->m_id] = false;
+
+    return {};
+}
diff --git a/src/GlassBackgroundElement.hpp b/src/GlassBackgroundElement.hpp
new file mode 100644
index 0000000..9c0a79e
--- /dev/null
+++ b/src/GlassBackgroundElement.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <hyprland/src/render/pass/PassElement.hpp>
+#include <hyprutils/math/Box.hpp>
+#include <hyprland/src/helpers/memory/Memory.hpp>
+
+// xray: captures the framebuffer as it stands at RENDER_PRE_WINDOWS --
+// wallpaper, background and bottom layers rendered, no windows yet -- into the
+// per-monitor backgroundFB that glass then samples instead of the live
+// framebuffer.
+//
+// The element is QUEUED from the render.stage event handler (the pass is being
+// built at that moment, so the element lands after the bottom layers and
+// before any window), but the GL blit happens here in draw(), when those
+// layers have actually been rendered. A blit in the handler itself would copy
+// an empty framebuffer: Hyprland's render pass is deferred.
+class CGlassBackgroundElement : public IPassElement {
+  public:
+    CGlassBackgroundElement()           = default;
+    ~CGlassBackgroundElement() override = default;
+
+    std::vector<UP<IPassElement>> draw() override;
+    [[nodiscard]] bool                needsLiveBlur() override { return false; }
+    [[nodiscard]] bool                needsPrecomputeBlur() override { return false; }
+    // Full-screen capture: no bounding box, and never let the pass simplify it
+    // away on small-damage frames -- it only runs when the cache is dirty, and
+    // a skipped run would leave the stale capture in place for good.
+    [[nodiscard]] std::optional<CBox> boundingBox() override { return std::nullopt; }
+    [[nodiscard]] bool                disableSimplification() override { return true; }
+
+    [[nodiscard]] const char* passName() override { return "CGlassBackgroundElement"; }
+    [[nodiscard]] ePassElementType type() override { return EK_CUSTOM; }
+};
diff --git a/src/GlassDecoration.cpp b/src/GlassDecoration.cpp
index 90bd1cb..9ea682c 100644
--- a/src/GlassDecoration.cpp
+++ b/src/GlassDecoration.cpp
@@ -188,6 +188,20 @@ void CGlassDecoration::renderPass(PHLMONITOR monitor, const float& alpha) {
     if (!source)
         return;
 
+    // Under xray, SAMPLE the windowless capture instead of the live
+    // framebuffer, so the backdrop is the wallpaper and bottom layers rather
+    // than the composited window stack. Only the sample source changes:
+    // blurBackground still re-binds `source` after its ping-pong and
+    // applyGlassEffect still draws the finished glass INTO `source` -- routing
+    // either of those at the capture would draw the effect off-screen.
+    // A monitor with no capture yet falls through to today's behaviour.
+    auto sampleSource = source;
+    if (g_pGlobalState->config.xray && **g_pGlobalState->config.xray) {
+        if (auto it = g_pGlobalState->backgroundFB.find(monitor->m_id);
+            it != g_pGlobalState->backgroundFB.end() && it->second)
+            sampleSource = it->second;
+    }
+
     auto optBox = WindowGeometry::computeWindowBox(window, monitor);
     if (!optBox)
         return;
@@ -208,7 +222,7 @@ void CGlassDecoration::renderPass(PHLMONITOR monitor, const float& alpha) {
     float blurStrength   = resolvePresetFloat(ctx, &SPresetValues::blurStrength, &SOverridableConfig::blurStrength);
     int downscale        = blurStrength >= GlassRenderer::BLUR_DOWNSCALE_THRESHOLD ? GlassRenderer::BLUR_DOWNSCALE_MAX : 1;
 
-    GlassRenderer::sampleBackground(m_sampleFramebuffer, source, transformBox, m_samplePaddingRatio, downscale);
+    GlassRenderer::sampleBackground(m_sampleFramebuffer, sampleSource, transformBox, m_samplePaddingRatio, downscale);
 
     float blurRadius     = blurStrength * 12.0f / downscale;
     int blurIterations   = std::clamp(static_cast<int>(resolvePresetInt(ctx, &SPresetValues::blurIterations, &SOverridableConfig::blurIterations)), 1, 5);
diff --git a/src/Globals.hpp b/src/Globals.hpp
index 0e78548..ecb4141 100644
--- a/src/Globals.hpp
+++ b/src/Globals.hpp
@@ -50,6 +50,35 @@ struct SGlobalState {
     // stale entry can never alias a reallocated monitor object.
     std::unordered_map<MONITORID, uint64_t> sceneGeneration;
 
+    // xray: windowless scene capture, one FB per monitor. Holds wallpaper +
+    // background + bottom layers and NO windows, so every glassed window on
+    // that monitor samples the same backdrop regardless of what is stacked
+    // beneath it. Keyed by MONITORID for the same reason sceneGeneration is.
+    std::unordered_map<MONITORID, SP<Render::IFramebuffer>> backgroundFB;
+    // Set when backgroundFB[id] no longer matches the scene. Mirrors
+    // Hyprland's own m_blurFBDirty: monitor-level and NOT per-frame -- window
+    // motion never sets it, which is precisely why xray is cheap.
+    std::unordered_map<MONITORID, bool> backgroundFBDirty;
+
+    // xray: per-layer-surface commit listeners. A wallpaper daemon repaints
+    // the background layer with plain surface commits -- no EventBus event
+    // fires -- so without these the capture goes stale until the next
+    // workspace switch. Same signal source Hyprland itself uses to set
+    // m_blurFBDirty (LayerSurface.cpp handles its own surface's commit).
+    // Keyed like layerSurfaces above; the listener dies when its SP is erased.
+    std::unordered_map<Desktop::View::CLayerSurface*, CHyprSignalListener> layerCommitListeners;
+
+    void dirtyBackground(const PHLMONITOR& mon) {
+        if (mon)
+            backgroundFBDirty[mon->m_id] = true;
+    }
+    void dirtyAllBackgrounds() {
+        for (auto& [id, fb] : backgroundFB)
+            backgroundFBDirty[id] = true;
+        // Monitors that have never captured take the no-FB path anyway; only
+        // known FBs need the flag.
+    }
+
     uint64_t getSceneGeneration(const PHLMONITOR& mon) const {
         if (!mon)
             return 0;

@@ -15,6 +16,11 @@
 #include <hyprland/src/config/ConfigManager.hpp>
 #include <hyprland/src/debug/log/Logger.hpp>
 #include <hyprland/src/event/EventBus.hpp>
+// xray commit watchers: CLayerShellResource and CWLSurfaceResource are only
+// forward-declared where LayerSurface.hpp uses them.
+#include <hyprland/src/protocols/LayerShell.hpp>
+#include <hyprland/src/protocols/core/Compositor.hpp>
+#include <hyprland/src/state/MonitorState.hpp>
 
 #include <cstdlib>
 #include <sstream>
@@ -254,6 +260,113 @@ APICALL EXPORT PLUGIN_DESCRIPTION_INFO PLUGIN_INIT(HANDLE handle) {
             if (ws) if (auto mon = ws->m_monitor.lock()) g_pGlobalState->bumpSceneGeneration(mon);
         });
 
+    // xray: a wallpaper daemon (awww/swww) repaints the background layer with
+    // plain surface commits and no EventBus event, so watch every layer
+    // surface's commit signal directly. The tier check lives in the CALLBACK,
+    // not at attach time, so a surface migrating between tiers (STATE_LAYER
+    // commit) needs no re-attach. Top/overlay commits (the bar's clock ticks)
+    // cost one integer compare each.
+    static auto watchLayerCommits = [](PHLLS ls) {
+        if (!g_pGlobalState || !ls)
+            return;
+        const auto shellResource = ls->m_layerSurface.lock();
+        if (!shellResource)
+            return;
+        const auto surface = shellResource->m_surface.lock();
+        if (!surface)
+            return;
+        g_pGlobalState->layerCommitListeners[ls.get()] = surface->m_events.commit.listen([lsRef = PHLLSREF(ls)]() {
+            if (!g_pGlobalState)
+                return;
+            const auto l = lsRef.lock();
+            if (!l)
+                return;
+            // zwlr tiers: 0 = background, 1 = bottom. Only those are in the
+            // windowless capture; higher tiers draw after windows.
+            if (l->m_layer > 1)
+                return;
+            if (auto mon = l->m_monitor.lock())
+                g_pGlobalState->dirtyBackground(mon);
+        });
+    };
+    // Layers that existed before the plugin loaded (the running wallpaper
+    // daemon is exactly this case).
+    for (auto& monitor : State::monitorState()->monitors())
+        for (auto& tier : monitor->m_layerSurfaceLayers)
+            for (auto& lsRef : tier)
+                watchLayerCommits(lsRef.lock());
+
+    // xray: invalidate the windowless background capture on events that change
+    // what sits BEHIND windows. Deliberately absent: window open/close/move/
+    // resize/focus -- not reacting to those is the whole point of xray.
+    static auto xrayEnabled = [&]() {
+        return g_pGlobalState && g_pGlobalState->config.xray && **g_pGlobalState->config.xray;
+    };
+    static auto onMonitorAdded = Event::bus()->m_events.monitor.added.listen(
+        [&](PHLMONITOR mon) { if (g_pGlobalState) g_pGlobalState->dirtyBackground(mon); });
+    static auto onMonitorRemoved = Event::bus()->m_events.monitor.removed.listen([&](PHLMONITOR mon) {
+        // Drop the FB outright: a re-enabled monitor gets a fresh id-keyed
+        // entry, and holding the old one would pin GPU memory for good.
+        if (g_pGlobalState && mon) {
+            g_pGlobalState->backgroundFB.erase(mon->m_id);
+            g_pGlobalState->backgroundFBDirty.erase(mon->m_id);
+        }
+    });
+    static auto onMonitorLayout = Event::bus()->m_events.monitor.layoutChanged.listen(
+        [&]() { if (g_pGlobalState) g_pGlobalState->dirtyAllBackgrounds(); });
+    // Layer events carry the surface, not its monitor; these are rare enough
+    // that dirtying every monitor is cheaper than chasing the association.
+    static auto onLayerOpenedX = Event::bus()->m_events.layer.opened.listen([&](PHLLS ls) {
+        if (!g_pGlobalState)
+            return;
+        g_pGlobalState->dirtyAllBackgrounds();
+        watchLayerCommits(ls);
+    });
+    static auto onLayerClosedX = Event::bus()->m_events.layer.closed.listen([&](PHLLS ls) {
+        if (!g_pGlobalState)
+            return;
+        g_pGlobalState->dirtyAllBackgrounds();
+        if (ls)
+            g_pGlobalState->layerCommitListeners.erase(ls.get());
+    });
+    static auto onLayerRulesX = Event::bus()->m_events.layer.updateRules.listen(
+        [&](PHLLS) { if (g_pGlobalState) g_pGlobalState->dirtyAllBackgrounds(); });
+    static auto onWorkspaceActiveX = Event::bus()->m_events.workspace.active.listen([&](PHLWORKSPACE ws) {
+        if (g_pGlobalState && ws)
+            if (auto mon = ws->m_monitor.lock())
+                g_pGlobalState->dirtyBackground(mon);
+    });
+    static auto onWorkspaceMoveX = Event::bus()->m_events.workspace.moveToMonitor.listen(
+        [&](PHLWORKSPACE, PHLMONITOR) { if (g_pGlobalState) g_pGlobalState->dirtyAllBackgrounds(); });
+
+    // Mirrors Hyprland's own preRender: a dirty capture needs the whole
+    // monitor damaged so the frame that refreshes it renders the full scene.
+    // Without this a partial-damage frame would blit stale regions into the
+    // capture and freeze them there.
+    static auto onRenderPre = Event::bus()->m_events.render.pre.listen([&](PHLMONITOR mon) {
+        if (!xrayEnabled() || !mon)
+            return;
+        const bool noFB = !g_pGlobalState->backgroundFB.contains(mon->m_id);
+        if (noFB || g_pGlobalState->backgroundFBDirty[mon->m_id])
+            g_pHyprRenderer->damageMonitor(mon);
+    });
+
+    // The pass is being BUILT while this fires; queueing here places the
+    // element after the bottom layers and before any window. The actual blit
+    // runs later, in the element's draw() -- see GlassBackgroundElement.
+    static auto onRenderStage = Event::bus()->m_events.render.stage.listen([&](eRenderStage stage) {
+        if (stage != RENDER_PRE_WINDOWS || !xrayEnabled())
+            return;
+        const auto mon = g_pHyprRenderer->m_renderData.pMonitor.lock();
+        if (!mon)
+            return;
+        const auto fbIt = g_pGlobalState->backgroundFB.find(mon->m_id);
+        const bool haveFB = fbIt != g_pGlobalState->backgroundFB.end() && fbIt->second;
+        if (haveFB && !g_pGlobalState->backgroundFBDirty[mon->m_id])
+            return; // cache valid: the capture costs nothing this frame
+        g_pHyprRenderer->m_renderPass.add(makeUnique<CGlassBackgroundElement>());
+    });
+
     // Clear pending presets/layers before config re-parse, commit after
     static auto onPreConfigReload = Event::bus()->m_events.config.preReload.listen([&]() {
         clearPendingPresets();
@@ -266,6 +379,8 @@ APICALL EXPORT PLUGIN_DESCRIPTION_INFO PLUGIN_INIT(HANDLE handle) {
         parseLayerNamespaceFilters();
         commitPendingLayers(); // merge Lua layer() calls on top of string config
         validateConfig();
+        // Wallpaper or layer rules may have changed under the capture.
+        g_pGlobalState->dirtyAllBackgrounds();
     });
 
 
@@ -323,6 +438,13 @@ APICALL EXPORT void PLUGIN_EXIT() {
     g_pHyprRenderer->m_renderPass.removeAllOfType("CGlassPassElement");
     g_pHyprRenderer->m_renderPass.removeAllOfType("CGlassLayerPassElement");
     g_pHyprRenderer->m_renderPass.removeAllOfType("CGlassLayerCompositeElement");
+    g_pHyprRenderer->m_renderPass.removeAllOfType("CGlassBackgroundElement");
+
+    // Release the xray captures while the GL context is still alive, and
+    // detach the commit watchers before their target surfaces outlive us.
+    g_pGlobalState->backgroundFB.clear();
+    g_pGlobalState->backgroundFBDirty.clear();
+    g_pGlobalState->layerCommitListeners.clear();
 
     for (auto& decoration : g_pGlobalState->decorations) {
         if (auto* deco = decoration.get())

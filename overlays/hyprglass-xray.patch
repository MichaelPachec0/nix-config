diff --git a/src/GlassRectDecoration.cpp b/src/GlassRectDecoration.cpp
new file mode 100644
index 0000000..f291250
--- /dev/null
+++ b/src/GlassRectDecoration.cpp
@@ -0,0 +1,335 @@
+#include "GlassRectDecoration.hpp"
+#include "Globals.hpp"
+#include "PluginConfig.hpp"
+#include "WindowGeometry.hpp"
+
+#include <hyprland/src/animation/AnimationManager.hpp>
+#include <hyprland/src/config/ConfigValue.hpp>
+#include <hyprland/src/config/shared/animation/AnimationTree.hpp>
+#include <hyprland/src/desktop/rule/windowRule/WindowRuleApplicator.hpp>
+#include <hyprland/src/desktop/state/FocusState.hpp>
+#include <hyprland/src/protocols/XDGShell.hpp>
+#include <hyprland/src/protocols/core/Compositor.hpp>
+#include <hyprland/src/render/Renderer.hpp>
+#include <hyprland/src/render/Texture.hpp>
+#include <hyprland/src/render/pass/RectPassElement.hpp>
+#include <hyprland/src/render/pass/SurfacePassElement.hpp>
+#include <hyprutils/math/Region.hpp>
+
+#include <algorithm>
+#include <charconv>
+#include <string_view>
+
+CGlassRectDecoration::CGlassRectDecoration(PHLWINDOW window)
+    : IHyprWindowDecoration(window), m_window(window) {
+    // Same curve Hyprland drives m_dimPercent with (Window.cpp: "fadeDim"),
+    // so a focus change under this overlay looks like a focus change without
+    // it. AVARDAMAGE_ENTIRE + the window context makes each tick damage the
+    // window box for us.
+    Animation::mgr()->createAnimation(0.f, m_dim, Config::animationTree()->getAnimationPropertyConfig("fadeDim"), window,
+                                      AVARDAMAGE_ENTIRE);
+}
+
+PHLWINDOW CGlassRectDecoration::getOwner() {
+    return m_window.lock();
+}
+
+// Hyprland's surface element, restricted to a clip box. The stock element
+// reports its whole texture box as opaque when drawn at alpha 1, which would
+// let the pass simplifier discard everything beneath the window outside the
+// hole (the base render, the glass). Report nothing opaque and only the
+// clipped area as bounds; the draw itself is the stock one.
+class CGlassRectSurfaceElement : public CSurfacePassElement {
+  public:
+    explicit CGlassRectSurfaceElement(const SRenderData& data) : CSurfacePassElement(data) {}
+
+    std::optional<CBox> boundingBox() override {
+        auto bb = CSurfacePassElement::boundingBox();
+        if (!bb || m_data.clipBox.empty())
+            return bb;
+        const auto mon   = m_data.pMonitor.lock();
+        const auto scale = mon ? mon->m_scale : 1.f;
+        return bb->intersection(m_data.clipBox.copy().scale(1.f / scale));
+    }
+
+    CRegion opaqueRegion() override {
+        return {};
+    }
+
+    const char* passName() override {
+        return "CGlassRectSurfaceElement";
+    }
+};
+
+// Parses "hyprglass_rect:x,y,w,h" (window-logical px, integers). A trailing
+// '*' marks a dynamic tag and is ignored. Returns false on any malformed
+// field; a bad tag is skipped rather than producing a garbage hole.
+static bool parseRectTag(std::string_view tag, CBox& out) {
+    if (!tag.starts_with(TAG_RECT_PREFIX))
+        return false;
+    tag.remove_prefix(TAG_RECT_PREFIX.size());
+    if (tag.ends_with('*'))
+        tag.remove_suffix(1);
+
+    int    fields[4] = {0, 0, 0, 0};
+    size_t n         = 0;
+    while (n < 4) {
+        const auto comma = tag.find(',');
+        const auto piece = tag.substr(0, comma);
+        if (piece.empty())
+            return false;
+        const auto res = std::from_chars(piece.data(), piece.data() + piece.size(), fields[n]);
+        if (res.ec != std::errc{} || res.ptr != piece.data() + piece.size())
+            return false;
+        ++n;
+        if (comma == std::string_view::npos)
+            break;
+        tag.remove_prefix(comma + 1);
+    }
+    if (n != 4 || fields[2] <= 0 || fields[3] <= 0)
+        return false;
+
+    out = CBox{(double)fields[0], (double)fields[1], (double)fields[2], (double)fields[3]};
+    return true;
+}
+
+bool CGlassRectDecoration::refreshRects(const PHLWINDOW& window) {
+    if (!window || !window->m_ruleApplicator)
+        return false;
+
+    const auto& tags = window->m_ruleApplicator->m_tagKeeper;
+
+    // Tags are a std::set, so iteration order is stable and the signature
+    // is canonical for a given set.
+    std::string sig;
+    for (const auto& tag : tags.getTags()) {
+        if (!std::string_view{tag}.starts_with(TAG_RECT_PREFIX))
+            continue;
+        sig += tag;
+        sig += '|';
+    }
+    const bool off = tags.isTagged(std::string(TAG_RECT_OFF));
+
+    if (sig == m_tagSig && off == m_off)
+        return !off && !m_rects.empty();
+
+    m_tagSig = sig;
+    m_off    = off;
+    m_rects.clear();
+    for (const auto& tag : tags.getTags()) {
+        CBox box;
+        if (parseRectTag(tag, box))
+            m_rects.push_back(box);
+    }
+    damageEntire();
+    return !off && !m_rects.empty();
+}
+
+SDecorationPositioningInfo CGlassRectDecoration::getPositioningInfo() {
+    SDecorationPositioningInfo info;
+    info.priority       = 10000;
+    info.policy         = DECORATION_POSITION_ABSOLUTE;
+    info.desiredExtents = {{0, 0}, {0, 0}};
+    return info;
+}
+
+void CGlassRectDecoration::onPositioningReply(const SDecorationPositioningReply& reply) {}
+
+void CGlassRectDecoration::draw(PHLMONITOR monitor, float const& alpha) {
+    const auto window = m_window.lock();
+    if (!window || !monitor || !g_pGlobalState)
+        return;
+
+    const auto& config     = g_pGlobalState->config;
+    const bool  dimOn      = !config.rectDim || **config.rectDim;
+    const bool  redrawOn   = !config.rectRedraw || **config.rectRedraw;
+    const float redrawA    = config.rectRedrawAlpha ? std::clamp((float)**config.rectRedrawAlpha, 0.f, 1.f) : 1.f;
+    const int   paddingLog = config.rectPadding ? std::max<int>(0, **config.rectPadding) : 0;
+
+    const bool tagged = refreshRects(window);
+
+    // Hyprland passes decorations fullAlpha = active alpha (the opacity rule,
+    // e.g. 0.9) x fade alpha. The redraw exists precisely to escape the rule
+    // alpha, so divide it back out and keep only the fade. Standalone and
+    // fullscreen renders pass rule alpha 1.0; the clamp covers that ratio.
+    const float ruleAlpha = window->alphaValue(Desktop::View::WINDOW_ALPHA_ACTIVE);
+    const float fade      = std::clamp(ruleAlpha > 0.001f ? alpha / ruleAlpha : alpha, 0.f, 1.f);
+
+    static auto PDIMENABLED  = CConfigValue<Config::INTEGER>("decoration:dim_inactive");
+    static auto PDIMSTRENGTH = CConfigValue<Config::FLOAT>("decoration:dim_strength");
+    static auto PDIMMODAL    = CConfigValue<Config::INTEGER>("decoration:dim_modal");
+
+    // D: what Hyprland WOULD dim this window to without no_dim. Mirrors the
+    // goalDim block in CWindow::updateWindowAnimatedDecorationValues.
+    float goal = 0.f;
+    if (tagged && dimOn) {
+        const bool focused = window == Desktop::focusState()->window();
+        if (!focused && *PDIMENABLED)
+            goal = *PDIMSTRENGTH;
+        if (*PDIMMODAL) {
+            const auto xdg = window->m_xdgSurface.lock();
+            if (xdg && xdg->m_toplevel && xdg->m_toplevel->anyChildModal())
+                goal += (1.f - goal) / 2.f;
+        }
+    }
+    if (m_dim->goal() != goal)
+        *m_dim = goal;
+
+    const float D = std::clamp(m_dim->value(), 0.f, 1.f);
+    if (!tagged && D <= 0.001f)
+        return; // untagged and faded out: nothing to draw
+
+    const auto boxOpt = WindowGeometry::computeWindowBox(window, monitor);
+    if (!boxOpt)
+        return;
+    const CBox windowBox = *boxOpt;
+    if (windowBox.width < 1 || windowBox.height < 1)
+        return;
+
+    const float scale         = monitor->m_scale;
+    const int   ROUND         = std::round(window->rounding() * scale);
+    const float ROUNDINGPOWER = window->roundingPower();
+    const float pad           = paddingLog * scale;
+
+    // Rects in monitor px, padded, clamped to the window box.
+    std::vector<CBox> holes;
+    holes.reserve(m_rects.size());
+    for (const auto& r : m_rects) {
+        CBox hole{windowBox.x + r.x * scale - pad, windowBox.y + r.y * scale - pad, r.width * scale + 2 * pad, r.height * scale + 2 * pad};
+        hole.round();
+        const double x1 = std::max(hole.x, windowBox.x), y1 = std::max(hole.y, windowBox.y);
+        const double x2 = std::min(hole.x + hole.width, windowBox.x + windowBox.width);
+        const double y2 = std::min(hole.y + hole.height, windowBox.y + windowBox.height);
+        if (x2 - x1 >= 1 && y2 - y1 >= 1)
+            holes.push_back(CBox{x1, y1, x2 - x1, y2 - y1});
+    }
+
+    // 1. Redraw the window's surfaces inside each rect, clipped to it, through
+    //    Hyprland's own surface element. That is deliberate: the toplevel
+    //    texture alone is NOT enough (Firefox draws page and video into a
+    //    wl_subsurface), and a plain texture blit of a subsurface ignores its
+    //    wp_viewporter crop, so a video whose surface is cropped as the page
+    //    scrolls came out squashed, and YUV video skipped the colour path.
+    //    CSurfacePassElement walks the same UV/viewport/colour code the base
+    //    render used; we only feed it alpha 1 (escaping the opacity rule),
+    //    the fade, and a clip box per hole. Surface tree walked breadthfirst
+    //    like renderWindow: subsurfaces, not popups.
+    if (tagged && redrawOn && redrawA > 0.001f && !holes.empty()) {
+        const auto wlSurface = window->wlSurface();
+        const auto mainRes   = wlSurface ? wlSurface->resource() : nullptr;
+        if (mainRes) {
+            // Same geometry the holes were cut from, back in logical
+            // monitor-global units, so hole and redraw cannot drift apart.
+            const Vector2D realPos  = Vector2D{windowBox.x, windowBox.y} / scale + monitor->m_position;
+            const Vector2D realSize = Vector2D{windowBox.width, windowBox.height} / scale;
+            int            counter  = 0;
+            mainRes->breadthfirst(
+                [&](SP<CWLSurfaceResource> s, const Vector2D& offset, void*) {
+                    if (!s || !s->m_current.texture)
+                        return;
+                    if (s->m_current.size.x < 1 || s->m_current.size.y < 1)
+                        return;
+
+                    const bool isMain = s == mainRes;
+                    // Monitor-px extent of this surface, only for the cheap
+                    // "does it touch the hole at all" test below.
+                    const CBox sbox = isMain ? windowBox :
+                                               CBox{windowBox.x + offset.x * scale, windowBox.y + offset.y * scale, //
+                                            s->m_current.size.x * scale, s->m_current.size.y * scale};
+
+                    for (const auto& hole : holes) {
+                        if (sbox.x >= hole.x + hole.width || sbox.x + sbox.width <= hole.x || sbox.y >= hole.y + hole.height || sbox.y + sbox.height <= hole.y)
+                            continue;
+                        CSurfacePassElement::SRenderData data;
+                        data.pMonitor       = monitor;
+                        data.pos            = realPos;
+                        data.w              = std::max(realSize.x, 5.0);
+                        data.h              = std::max(realSize.y, 5.0);
+                        data.localPos       = offset;
+                        data.surface        = s;
+                        data.texture        = s->m_current.texture;
+                        data.mainSurface    = isMain;
+                        data.pWindow        = window;
+                        data.alpha          = redrawA;
+                        data.fadeAlpha      = fade;
+                        data.blur           = false;
+                        data.decorate       = false;
+                        data.rounding       = ROUND;
+                        data.roundingPower  = ROUNDINGPOWER;
+                        data.dontRound      = false;
+                        data.surfaceCounter = counter;
+                        data.clipBox        = hole;
+                        g_pHyprRenderer->addPassElement(makeUnique<CGlassRectSurfaceElement>(data));
+                    }
+                    ++counter;
+                },
+                nullptr);
+        }
+    }
+
+    // 2. Dim with holes.
+    if (!dimOn)
+        return;
+
+    // a: Hyprland's residual tint, nonzero only while its own fadeDim is still
+    // running after the bridge flipped no_dim. b keeps (1-a)(1-b) == (1-D).
+    const float a = window->m_dimPercent ? std::clamp(window->m_dimPercent->value(), 0.f, 0.999f) : 0.f;
+    float       b = 1.f - (1.f - D) / (1.f - a);
+    b             = std::clamp(b, 0.f, 1.f) * fade;
+    if (b <= 0.002f)
+        return;
+
+    CRegion dimRegion{windowBox};
+    for (const auto& hole : holes)
+        dimRegion.subtract(CRegion{hole});
+
+    const auto COLOR = CHyprColor(0.0, 0.0, 0.0, b);
+
+    // One pass per remaining piece: the full window box (so rounding lands
+    // on the real corners) clipped to the piece. Hyprland's element renderer
+    // applies clipBox as scissor in scaled coordinates, which windowBox is.
+    for (const auto& px : dimRegion.getRects()) {
+        CRectPassElement::SRectData data;
+        data.box           = windowBox;
+        data.color         = COLOR;
+        data.round         = ROUND;
+        data.roundingPower = ROUNDINGPOWER;
+        data.clipBox       = CBox{(double)px.x1, (double)px.y1, (double)(px.x2 - px.x1), (double)(px.y2 - px.y1)};
+        g_pHyprRenderer->addPassElement(makeUnique<CRectPassElement>(data));
+    }
+}
+
+eDecorationType CGlassRectDecoration::getDecorationType() {
+    return DECORATION_CUSTOM;
+}
+
+void CGlassRectDecoration::updateWindow(PHLWINDOW window) {
+    damageEntire();
+}
+
+void CGlassRectDecoration::damageEntire() {
+    const auto window = m_window.lock();
+    if (!window)
+        return;
+
+    const auto workspace  = window->m_workspace;
+    auto       surfaceBox = window->getWindowMainSurfaceBox();
+
+    if (workspace && workspace->m_renderOffset->isBeingAnimated() && !window->m_pinned)
+        surfaceBox.translate(workspace->m_renderOffset->value());
+    surfaceBox.translate(window->m_floatingOffset);
+
+    g_pHyprRenderer->damageBox(surfaceBox);
+}
+
+eDecorationLayer CGlassRectDecoration::getDecorationLayer() {
+    return DECORATION_LAYER_OVER;
+}
+
+uint64_t CGlassRectDecoration::getDecorationFlags() {
+    return DECORATION_NON_SOLID;
+}
+
+std::string CGlassRectDecoration::getDisplayName() {
+    return "HyprGlassRect";
+}

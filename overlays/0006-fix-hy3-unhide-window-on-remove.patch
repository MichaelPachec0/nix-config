 	window->m_ruleApplicator->resetProps(Desktop::Rule::RULE_PROP_ALL, Desktop::Types::PRIORITY_LAYOUT);
 
+	// A non-visible tab is hidden by its group (Hy3Node::updateTabBar ->
+	// setHidden). Once the window leaves the tree (floated, moved to another
+	// workspace, closed) nothing owns that flag any more, so an invisible tab
+	// that gets floated stays unrendered: Hyprland skips it, it receives no
+	// frame callbacks and clients like Firefox treat their documents as
+	// hidden. Clear it here; if the window re-enters a group, that group's
+	// next geometry pass re-applies its own hidden state.
+	window->setHidden(false);

+void CMonitor::applyCMType(NCMType::eCMType cmType, NTransferFunction::eTF cmSdrEotf) {
+    static auto PAUTOHDR            = CConfigValue<Config::INTEGER>("render:cm_auto_hdr");
+    auto        oldImageDescription = m_imageDescription;
+
+    m_imageDescription = makeImageDescription(cmType, cmSdrEotf);
+
+    // The description this output flips to under cm_auto_hdr (mirrors
+    // IHyprRenderer::handleFullscreenSettings: 2 = hdredid, otherwise hdr).
+    // Built here, next to the real one, so it follows the same EDID/monitor-rule
+    // luminance overrides; CImageDescription::from() dedups by value, so its id
+    // is stable across the SDR <-> HDR flips and clients do not see churn.
+    m_autoHDRImageDescription =
+        supportsHDR() ? makeImageDescription(*PAUTOHDR == 2 ? NCMType::CM_HDR_EDID : NCMType::CM_HDR, cmSdrEotf) : NColorManagement::PImageDescription{};
+
     if (oldImageDescription != m_imageDescription) {
         if (PROTO::colorManagement)
             PROTO::colorManagement->onMonitorImageDescriptionChanged(m_self);
@@ -649,6 +666,22 @@
     }
 }
 
+NColorManagement::PImageDescription CMonitor::advertisedImageDescription() {
+    static auto PAUTOHDR   = CConfigValue<Config::INTEGER>("render:cm_auto_hdr");
+    static auto PADVERTISE = CConfigValue<Config::INTEGER>("render:cm_auto_hdr_advertise");
+
+    // Under cm_auto_hdr the output idles in SDR and switches to HDR only once a
+    // fullscreen client presents a PQ/HLG surface. Clients decide whether to do
+    // that from the output / preferred image description, which is the SDR one
+    // (sRGB, 80 cd/m2), so Firefox, mpv and friends all conclude "SDR display"
+    // and never ask: auto-HDR cannot start on its own. When asked to, tell
+    // HDR-capable outputs' clients about the HDR description they would get.
+    if (*PADVERTISE && *PAUTOHDR && supportsHDR() && m_autoHDRImageDescription.valid())
+        return m_autoHDRImageDescription;
+
+    return m_imageDescription;
+}

+void CDMABuffer::setYUVColorSpace(NFormatUtils::eYUVColorSpace cs) {
+    if (cs == NFormatUtils::YUV_CS_AUTO || cs == m_yuvColorSpace || !NFormatUtils::isFormatYUV(m_attrs.format))
+        return;
+
+    // the same buffer objects get reused frame after frame (a pool of a few), so
+    // this happens once per buffer, not once per frame.
+    auto tex = g_pHyprRenderer->createTexture(m_attrs, m_opaque, cs);
+    if (!tex || !tex->ok()) {
+        Log::logger->log(Log::ERR, "CDMABuffer: failed to re-import EGLImage for YUV color space {}", sc<int>(cs));
+        return;
+    }
+
+    m_texture       = tex;
+    m_yuvColorSpace = cs;
+}
+
 bool CDMABuffer::good() {
     return m_success;
 }

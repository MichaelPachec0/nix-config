diff -ruN a/src/protocols/ColorRepresentation.cpp b/src/protocols/ColorRepresentation.cpp
--- a/src/protocols/ColorRepresentation.cpp
+++ b/src/protocols/ColorRepresentation.cpp
@@ -0,0 +1,154 @@
+#include "ColorRepresentation.hpp"
+#include "color-representation-v1.hpp"
+#include <array>
+
+CColorRepresentationManager::CColorRepresentationManager(SP<CWpColorRepresentationManagerV1> resource) : m_resource(resource) {
+    if UNLIKELY (!good())
+        return;
+
+    m_resource->setDestroy([this](CWpColorRepresentationManagerV1* r) { PROTO::colorRepresentation->destroyResource(this); });
+    m_resource->setOnDestroy([this](CWpColorRepresentationManagerV1* r) { PROTO::colorRepresentation->destroyResource(this); });
+
+    m_resource->setGetSurface([](CWpColorRepresentationManagerV1* r, uint32_t id, wl_resource* surface) {
+        LOGM(Log::TRACE, "Get color representation surface for id={}, surface={}", id, (uintptr_t)surface);
+        auto SURF = CWLSurfaceResource::fromResource(surface);
+
+        if (!SURF) {
+            LOGM(Log::ERR, "No surface for resource {}", (uintptr_t)surface);
+            r->error(-1, "Invalid surface");
+            return;
+        }
+
+        if (SURF->m_colorRepresentation) {
+            r->error(WP_COLOR_REPRESENTATION_MANAGER_V1_ERROR_SURFACE_EXISTS, "Surface already has a color representation object");
+            return;
+        }
+
+        const auto RESOURCE = PROTO::colorRepresentation->m_surfaces.emplace_back(
+            makeShared<CColorRepresentationSurface>(makeShared<CWpColorRepresentationSurfaceV1>(r->client(), r->version(), id), SURF));
+        if UNLIKELY (!RESOURCE->good()) {
+            r->noMemory();
+            PROTO::colorRepresentation->m_surfaces.pop_back();
+            return;
+        }
+
+        RESOURCE->m_self            = RESOURCE;
+        SURF->m_colorRepresentation = RESOURCE;
+    });
+
+    // what this compositor can honor: premultiplied alpha (the only thing the
+    // renderer does) and the YCbCr matrices EGL_EXT_image_dma_buf_import can name.
+    m_resource->sendSupportedAlphaMode(WP_COLOR_REPRESENTATION_SURFACE_V1_ALPHA_MODE_PREMULTIPLIED_ELECTRICAL);
+
+    static const std::array<std::pair<wpColorRepresentationSurfaceV1Coefficients, wpColorRepresentationSurfaceV1Range>, 7> PAIRS = {{
+        {WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_IDENTITY, WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_FULL},
+        {WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT601, WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_LIMITED},
+        {WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT601, WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_FULL},
+        {WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT709, WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_LIMITED},
+        {WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT709, WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_FULL},
+        {WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT2020, WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_LIMITED},
+        {WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT2020, WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_FULL},
+    }};
+    for (const auto& [COEFFS, RANGE] : PAIRS)
+        m_resource->sendSupportedCoefficientsAndRanges(COEFFS, RANGE);
+
+    m_resource->sendDone();
+}
+
+bool CColorRepresentationManager::good() {
+    return m_resource->resource();
+}
+
+CColorRepresentationSurface::CColorRepresentationSurface(SP<CWpColorRepresentationSurfaceV1> resource, WP<CWLSurfaceResource> surface) :
+    m_surface(surface), m_resource(resource) {
+    if UNLIKELY (!good())
+        return;
+
+    m_client = m_resource->client();
+
+    m_resource->setDestroy([this](CWpColorRepresentationSurfaceV1* r) { PROTO::colorRepresentation->destroyResource(this); });
+    m_resource->setOnDestroy([this](CWpColorRepresentationSurfaceV1* r) { PROTO::colorRepresentation->destroyResource(this); });
+
+    // the wl_surface can go away first; the object then becomes inert.
+    m_surfaceDestroy = m_surface->m_events.destroy.listen([this] { m_surface.reset(); });
+
+    m_resource->setSetAlphaMode([this](CWpColorRepresentationSurfaceV1* r, wpColorRepresentationSurfaceV1AlphaMode mode) {
+        if (!m_surface) {
+            r->error(WP_COLOR_REPRESENTATION_SURFACE_V1_ERROR_INERT, "Surface is gone");
+            return;
+        }
+        if (mode != WP_COLOR_REPRESENTATION_SURFACE_V1_ALPHA_MODE_PREMULTIPLIED_ELECTRICAL) {
+            r->error(WP_COLOR_REPRESENTATION_SURFACE_V1_ERROR_ALPHA_MODE, "Unsupported alpha mode");
+            return;
+        }
+        m_pending.alphaMode = mode;
+    });
+
+    m_resource->setSetCoefficientsAndRange(
+        [this](CWpColorRepresentationSurfaceV1* r, wpColorRepresentationSurfaceV1Coefficients coefficients, wpColorRepresentationSurfaceV1Range range) {
+            if (!m_surface) {
+                r->error(WP_COLOR_REPRESENTATION_SURFACE_V1_ERROR_INERT, "Surface is gone");
+                return;
+            }
+            if (!CColorRepresentationProtocol::supportsCoefficients(coefficients, range)) {
+                r->error(WP_COLOR_REPRESENTATION_SURFACE_V1_ERROR_COEFFICIENTS, "Unsupported coefficients/range");
+                return;
+            }
+            m_pending.coefficients = coefficients;
+            m_pending.range        = range;
+        });
+
+    m_resource->setSetChromaLocation([this](CWpColorRepresentationSurfaceV1* r, wpColorRepresentationSurfaceV1ChromaLocation location) {
+        if (!m_surface) {
+            r->error(WP_COLOR_REPRESENTATION_SURFACE_V1_ERROR_INERT, "Surface is gone");
+            return;
+        }
+        // stored for completeness; the import path does not pass siting hints.
+        m_pending.chromaLocation = location;
+    });
+}
+
+bool CColorRepresentationSurface::good() {
+    return m_resource && m_resource->resource();
+}
+
+wl_client* CColorRepresentationSurface::client() {
+    return m_client;
+}
+
+void CColorRepresentationSurface::onCommit() {
+    m_current = m_pending;
+}
+
+CColorRepresentationProtocol::CColorRepresentationProtocol(const wl_interface* iface, const int& ver, const std::string& name) : IWaylandProtocol(iface, ver, name) {
+    ;
+}
+
+void CColorRepresentationProtocol::bindManager(wl_client* client, void* data, uint32_t ver, uint32_t id) {
+    const auto RESOURCE = m_managers.emplace_back(makeShared<CColorRepresentationManager>(makeShared<CWpColorRepresentationManagerV1>(client, ver, id)));
+
+    if UNLIKELY (!RESOURCE->good()) {
+        wl_client_post_no_memory(client);
+        m_managers.pop_back();
+        return;
+    }
+}
+
+bool CColorRepresentationProtocol::supportsCoefficients(wpColorRepresentationSurfaceV1Coefficients coefficients, wpColorRepresentationSurfaceV1Range range) {
+    switch (coefficients) {
+        case WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_IDENTITY: return range == WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_FULL;
+        case WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT601:
+        case WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT709:
+        case WP_COLOR_REPRESENTATION_SURFACE_V1_COEFFICIENTS_BT2020:
+            return range == WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_FULL || range == WP_COLOR_REPRESENTATION_SURFACE_V1_RANGE_LIMITED;
+        default: return false;
+    }
+}
+
+void CColorRepresentationProtocol::destroyResource(CColorRepresentationManager* resource) {
+    std::erase_if(m_managers, [&](const auto& other) { return other.get() == resource; });
+}
+
+void CColorRepresentationProtocol::destroyResource(CColorRepresentationSurface* resource) {
+    std::erase_if(m_surfaces, [&](const auto& other) { return other.get() == resource; });
+}
diff -ruN a/src/protocols/ColorRepresentation.hpp b/src/protocols/ColorRepresentation.hpp
--- a/src/protocols/ColorRepresentation.hpp
+++ b/src/protocols/ColorRepresentation.hpp
@@ -0,0 +1,72 @@
+#pragma once
+
+#include <optional>
+#include "WaylandProtocol.hpp"
+#include "core/Compositor.hpp"
+#include "color-representation-v1.hpp"
+
+class CColorRepresentationManager {
+  public:
+    CColorRepresentationManager(SP<CWpColorRepresentationManagerV1> resource);
+
+    bool good();
+
+  private:
+    SP<CWpColorRepresentationManagerV1> m_resource;
+};
+
+class CColorRepresentationSurface {
+  public:
+    CColorRepresentationSurface(SP<CWpColorRepresentationSurfaceV1> resource, WP<CWLSurfaceResource> surface);
+
+    bool       good();
+    wl_client* client();
+
+    // color-representation state is double-buffered: requests fill m_pending,
+    // wl_surface.commit copies it to m_current (CWLSurfaceResource::commitState).
+    struct SState {
+        std::optional<wpColorRepresentationSurfaceV1AlphaMode>      alphaMode;
+        std::optional<wpColorRepresentationSurfaceV1Coefficients>   coefficients;
+        std::optional<wpColorRepresentationSurfaceV1Range>          range;
+        std::optional<wpColorRepresentationSurfaceV1ChromaLocation> chromaLocation;
+    };
+
+    SState                          m_pending, m_current;
+    void                            onCommit();
+
+    WP<CColorRepresentationSurface> m_self;
+    WP<CWLSurfaceResource>          m_surface;
+
+  private:
+    SP<CWpColorRepresentationSurfaceV1> m_resource;
+    wl_client*                          m_client = nullptr;
+
+    CHyprSignalListener                 m_surfaceDestroy;
+
+    friend class CColorRepresentationProtocol;
+};
+
+class CColorRepresentationProtocol : public IWaylandProtocol {
+  public:
+    CColorRepresentationProtocol(const wl_interface* iface, const int& ver, const std::string& name);
+
+    virtual void bindManager(wl_client* client, void* data, uint32_t ver, uint32_t id);
+
+    // the coefficient/range pairs this compositor can honor through the EGL
+    // import hints; also what bindManager advertises.
+    static bool  supportsCoefficients(wpColorRepresentationSurfaceV1Coefficients coefficients, wpColorRepresentationSurfaceV1Range range);
+
+  private:
+    void                                         destroyResource(CColorRepresentationManager* resource);
+    void                                         destroyResource(CColorRepresentationSurface* resource);
+
+    std::vector<SP<CColorRepresentationManager>> m_managers;
+    std::vector<SP<CColorRepresentationSurface>> m_surfaces;
+
+    friend class CColorRepresentationManager;
+    friend class CColorRepresentationSurface;
+};
+
+namespace PROTO {
+    inline UP<CColorRepresentationProtocol> colorRepresentation;
+};

@@ -485,18 +485,31 @@ dbUasv CInputCapturePortal::onRelease(sdbus::ObjectPath sessionHandle, std::stri
     if (!sessionValid(sessionHandle))
         return {1, {}};
 
-    if (!opts.contains("activation_id")) {
-        Debug::log(WARN, "[input-capture] Release missing activation_id");
-        return {1, {}};
-    }
+    const auto& session      = m_sessions[sessionHandle];
+    uint32_t    activationId = 0;
 
-    uint32_t activationId = 0;
-    try {
-        activationId = opts["activation_id"].get<uint32_t>();
-    } catch (std::exception& e) {
-        Debug::log(WARN, "[input-capture] invalid activation_id: {}", e.what());
+    if (opts.contains("activation_id")) {
+        try {
+            activationId = opts["activation_id"].get<uint32_t>();
+        } catch (std::exception& e) {
+            Debug::log(WARN, "[input-capture] invalid activation_id: {}", e.what());
+            return {1, {}};
+        }
+    } else if (session->activationLive) {
+        // Returning early here strands the user: the client believes it
+        // released, but the compositor never hears it, so every key and pointer
+        // event keeps going to libei instead of the desktop. Nothing clears
+        // that except a zone-set invalidation (a monitor hotplug), so the
+        // session looks frozen -- no cursor, no keys -- until a display is
+        // plugged or unplugged. Honour the activation we know is live instead.
+        // org.kde.kdeconnect.daemon omits the key on every Release.
+        activationId = session->activeActivationId;
+        Debug::log(WARN, "[input-capture] Release missing activation_id, using live activation {}", activationId);
+    } else {
+        Debug::log(WARN, "[input-capture] Release missing activation_id and no activation is live, ignoring");
         return {1, {}};
     }

--- a/src/desktop/view/Popup.cpp
+++ b/src/desktop/view/Popup.cpp
@@ -77,7 +77,7 @@ eViewType CPopup::type() const {
 }
 
 bool CPopup::visible() const {
-    if (!m_mapped || !m_wlSurface->resource())
+    if (!m_mapped || !m_wlSurface || !m_wlSurface->resource())
         return false;
 
     if (!m_windowOwner.expired())
@@ -239,7 +239,7 @@ void CPopup::onUnmap() {
     if (!m_mapped)
         return;
 
-    if (!m_resource || !m_resource->m_surface) {

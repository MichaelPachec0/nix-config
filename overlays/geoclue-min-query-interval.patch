         g_autoptr(GError) local_error = NULL;
+        gint interval;
 
         task = g_task_new (source, cancellable, callback, user_data);
         g_task_set_source_tag (task, gclue_web_source_real_refresh_async);
@@ -109,6 +170,39 @@

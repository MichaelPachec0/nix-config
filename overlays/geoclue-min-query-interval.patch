+/* Time of the last query sent by any web source, as monotonic microseconds.
+ * Deliberately not per-instance: the sources are refcounted singletons that
+ * are destroyed when the last client goes away, so per-instance state would
+ * reset whenever a consumer stops and restarts, and a bursty consumer would
+ * evade the limit entirely. One budget covers every web source.
+ */
+static gint64 last_query_time;
+
 enum
 {
         PROP_0,
@@ -77,6 +89,54 @@
                               GAsyncResult *result,
                               gpointer      user_data);
 
+/* Hand consumers the last response again instead of nothing. Same idiom as
+ * the WiFi source's own cache hit: duplicated so the timestamp is refreshed,
+ * so a throttled window looks like an unchanged location rather than a
+ * missing one. Consumers have no concept of throttling and must not need one.
+ */
+static void
+replay_last_location (GClueWebSource *source)
+{
+        GClueWebSourcePrivate *priv = source->priv;
+        g_autoptr(GClueLocation) replay = NULL;
+
+        if (priv->last_location == NULL)
+                return;
+
+        replay = gclue_location_duplicate_fresh (priv->last_location);
+        gclue_location_source_set_location (GCLUE_LOCATION_SOURCE (source),
+                                            replay);
+}
+
+static gboolean
+on_throttle_timeout (gpointer user_data)
+{
+        GClueWebSource *source = GCLUE_WEB_SOURCE (user_data);
+
+        source->priv->throttle_timeout_id = 0;
+        gclue_web_source_refresh (source);
+
+        return G_SOURCE_REMOVE;
+}
+
+/* Coalesce, do not drop: one deferred query stands in for every call that
+ * arrives inside the window, so a location change is delayed by at most the
+ * interval rather than lost until the next scan happens to fire.
+ */
+static void
+schedule_throttled_refresh (GClueWebSource *source,
+                            guint           seconds)
+{
+        GClueWebSourcePrivate *priv = source->priv;
+
+        if (priv->throttle_timeout_id != 0)
+                return;
+
+        priv->throttle_timeout_id = g_timeout_add_seconds (seconds,
+                                                           on_throttle_timeout,
+                                                           source);
+}
+
 static void
 gclue_web_source_real_refresh_async (GClueWebSource      *source,
                                      GCancellable        *cancellable,
@@ -85,6 +145,7 @@
 {

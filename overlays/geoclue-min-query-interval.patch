+                                                 G_IO_ERROR_PENDING,
+                                                 "Query throttled, next in %u seconds",
+                                                 remaining);
+                        return;
+                }
+
+                /* Stamped before the send: a query that fails still cost a
+                 * request against the provider's quota.
+                 */
+                last_query_time = now;
+        }

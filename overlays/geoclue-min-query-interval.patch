@@ -59,6 +59,20 @@
 # Enable Modem GPS source
 enable=true
 
+# Global network query configuration options
+[network]
+
+# Minimum number of seconds between two queries to a web geolocation
+# service, across all sources. Queries that arrive sooner are answered with
+# the last known location, and a single query is scheduled for when the
+# interval expires. A change of network resets the interval, so arriving
+# somewhere new is not delayed.
+#
+# This bounds the request rate against providers that meter or bill per
+# query: an interval of N seconds allows at most 2592000/N queries per 30
+# days. Set to 0 or a negative value to query as often as the sources ask.
+min-query-interval=600
+
 # WiFi source configuration options
 [wifi]
 

         }
 
+        interval = gclue_config_get_min_query_interval
+                (gclue_config_get_singleton ());
+        if (interval > 0) {
+                gint64 now = g_get_monotonic_time ();
+                gint64 next = last_query_time +
+                        (gint64) interval * G_USEC_PER_SEC;
+
+                if (last_query_time != 0 && now < next) {
+                        guint remaining = (next - now + G_USEC_PER_SEC - 1) /
+                                G_USEC_PER_SEC;
+
+                        replay_last_location (source);
+                        schedule_throttled_refresh (source, remaining);
+
+                        /* Not an error the consumer must handle: it already
+                         * has a location. G_IO_ERROR_PENDING keeps this off
+                         * the warning path and stops the WiFi source from

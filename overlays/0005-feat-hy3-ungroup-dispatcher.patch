+static std::optional<UngroupOption> parseUngroupArg(std::string_view arg) {
+	// No argument keeps the cheap, per-window meaning as the default.
+	if (arg == "" || arg == "node") return UngroupOption::Node;
+	if (arg == "group") return UngroupOption::Group;
+	return {};
+}
+
+static SDispatchResult ungroup(UngroupOption scope) {
+	auto* hy3 = hy3InstanceForAction();
+	if (!hy3) return SDispatchResult {};
+
+	hy3->ungroupOnWorkspace(hy3->workspace().get(), scope);
+	return SDispatchResult {};
+}
+
+static int luaUngroup(lua_State* L) {
+	static constexpr const char* FN = "hl.plugin.hy3.ungroup";
+	luaCheckArgCount(L, FN, 0, 1);
+
+	auto scope = UngroupOption::Node;
+	if (lua_gettop(L) >= 1) {
+		auto value = luaStringArg(L, 1, FN, "scope");
+		auto parsed = parseUngroupArg(value);
+		if (!parsed)
+			return luaL_error(L, "%s: invalid scope '%s' (expected node/group)", FN, value.c_str());
+		scope = *parsed;
+	}
+
+	auto dspUngroup = [](lua_State* L) -> int {
+		ungroup(static_cast<UngroupOption>(lua_tointeger(L, lua_upvalueindex(1))));
+		return 0;
+	};
+
+	lua_pushinteger(L, static_cast<lua_Integer>(scope));
+	lua_pushcclosure(L, dspUngroup, 1);
+	return 1;
+}
+
+static SDispatchResult dispatch_ungroup(std::string value) {
+	auto scope = parseUngroupArg(CVarList(value)[0]);
+	if (!scope) return SDispatchResult {};
+	return ungroup(*scope);
+}

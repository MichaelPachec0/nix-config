+void Hy3Layout::ungroupOnWorkspace(const CWorkspace* workspace, UngroupOption scope) {
+	auto* node = this->getWorkspaceFocusedNode(workspace);
+	if (node == nullptr) return;
+
+	auto& actor = node->getPlacementActor();
+	if (scope == UngroupOption::Node) this->ungroupNode(actor);
+	else this->ungroup(actor);
+}
+
+// Lift `node` out of its group into the grandparent, leaving the group (and its
+// remaining children) intact -- ((a - b - c) | d) focused on `a` yields
+// ((b - c) | a | d). The group is collapsed by the usual rules if the removal
+// leaves it degenerate.
+void Hy3Layout::ungroupNode(Hy3Node& node) {
+	auto* group_node = node.parent.get();
+	if (group_node == nullptr || !group_node->is_group() || group_node->is_root()) return;
+
+	auto* parent_node = group_node->parent.get();
+	if (parent_node == nullptr || !parent_node->is_group()) return;
+
+	auto& group = group_node->as_group();
+
+	// A group parented to the ROOT node is the workspace's top-level group, and
+	// there is no level above it to move into: the root node lays every child
+	// out at the full workspace size, so it must keep exactly one child. Make
+	// room rather than refusing -- wrap the group in a new split of the layout
+	// it had before it was tabbed (the same one hy3's own `untab` restores) and
+	// pop the node out into that, so top-level tabs(a, b, c) focused on `a`
+	// becomes (tabs(b, c) | a).
+	if (parent_node->is_root()) {
+		// A split group at the top level already IS the outermost grouping --
+		// there is no enclosing group to lift the node out into.
+		if (!group.isTab()) return;
+
+		group_node->wrap(group.previous_nontab_layout, GroupEphemeralityOption::Standard);
+		parent_node = group_node->parent.get();
+		if (parent_node == nullptr || !parent_node->is_group() || parent_node->is_root()) return;
+	}
+
+	auto& parent = parent_node->as_group();
+
+	auto pos = parent.findChild(*group_node);
+	if (pos == parent.children.end()) return;
+
+	// extractChild redistributes the freed space across the group's remaining
+	// children and resets the extracted node's ratio to 1.0, which is exactly
+	// the ratio the parent's invariant (sum == children.size()) wants for a
+	// newly inserted child -- so no renormalization is needed here.
+	auto extracted = group.extractChild(node);
+	if (extracted == nullptr) return;
+
+	auto* refocus = extracted.get();
+	parent.insertChild(std::next(pos), std::move(extracted));
+	parent.group_focused = false;
+
+	// The group may now be degenerate (one child, or none if `node` was its last
+	// window); collapse it with the same policy hy3 uses when a window is moved
+	// out of a group. This can destroy group_node, so nothing touches it after.
+	group_node->updateTabBarRecursive();
+	group_node->collapseParents(CollapsePolicy::EmptySplits);
+	this->recalcGeometry();
+	refocus->focus(false, Desktop::FOCUS_REASON_KEYBIND);
+	this->recalcGeometry();
+}
+
+// Dissolve the group around `node`, splicing its children into the grandparent
+// at the group's old slot -- the inverse of makeGroup/groupWith and the one
+// thing makeGroup's `toggle` cannot do (it only collapses a group that has a
+// SINGLE child). With ((a - b) | c) focused on `a`, ungroup yields (a | b | c).
+// A focused group node dissolves itself; a focused window dissolves the group
+// holding it.
+void Hy3Layout::ungroup(Hy3Node& node) {
+	auto* group_node = node.is_group() ? &node : node.parent.get();
+	if (group_node == nullptr || !group_node->is_group() || group_node->is_root()) return;
+
+	auto* parent_node = group_node->parent.get();
+	if (parent_node == nullptr || !parent_node->is_group()) return;
+
+	auto& group = group_node->as_group();
+
+	auto child_count = group.children.size();
+	if (child_count == 0) return;
+
+	// The workspace's top-level group cannot be spliced into its parent: the
+	// root node lays every child out at the full workspace size, so it holds
+	// exactly one group by design. Dissolving the tabs there means untabbing
+	// them in place -- the children end up side by side at the same level,
+	// which is the same end state the splice below produces one level down.
+	if (parent_node->is_root()) {
+		if (!group.isTab()) return;
+
+		group.setLayout(group.previous_nontab_layout);
+		group_node->updateTabBarRecursive();
+		this->recalcGeometry();
+		return;
+	}
+
+	auto& parent = parent_node->as_group();
+
+	auto pos = parent.findChild(*group_node);
+	if (pos == parent.children.end()) return;
+
+	// Refocus a real window afterwards: `node` itself may be the group we are
+	// about to destroy, so resolve down to the focused leaf while it still
+	// exists. The leaf survives -- it just gets a new parent.
+	auto* refocus = &node.getFocusedNode(true);
+	if (refocus->is_group()) refocus = nullptr;
+
+	// Splice the children into the parent in order, ahead of the group's slot,
+	// scaling each by the group's share so relative sizes are preserved. hy3
+	// keeps sum(size_ratio) == children.size() within a group, so the parent is
+	// renormalized once the splice is done.
+	auto group_ratio = group_node->size_ratio;
+	while (!group.children.empty()) {
+		auto child = group.extractChildRaw(group.children.begin());
+		if (child == nullptr) break;
+		child->size_ratio *= group_ratio / static_cast<double>(child_count);
+		parent.insertChild(pos, std::move(child));
+	}
+
+	// Drop the now-empty group (the returned UP is discarded -> destroyed).
+	parent.extractChildRaw(*group_node);
+	parent.group_focused = false;
+
+	double sum = 0;
+	for (auto& child: parent.children) sum += child->size_ratio;
+	if (sum > 0) {
+		auto norm = static_cast<double>(parent.children.size()) / sum;
+		for (auto& child: parent.children) child->size_ratio *= norm;
+	}
+
+	// updateTabBarRecursive BEFORE collapseParents: collapsing can destroy
+	// parent_node (it is replaced by its sole child in the grandparent).
+	parent_node->updateTabBarRecursive();
+	parent_node->collapseParents(CollapsePolicy::InvalidOnly);
+	this->recalcGeometry();
+	if (refocus != nullptr) refocus->focus(false, Desktop::FOCUS_REASON_KEYBIND);
+	this->recalcGeometry();
+}

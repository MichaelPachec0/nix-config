{
  "manifest_version": 2,
  "name": "ff-hyprglass-bridge",
  "version": "0.1.0",
  "description": "Signals Hyprland (hyprglass) when a video is playing in this window.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ff-hyprglass-bridge@michaelpacheco.org",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["tabs", "nativeMessaging", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
